# Copy this file to .env and fill in real values. NEVER commit .env.

# Required for the agent orchestrator's LLM calls (Anthropic Claude).
# If unset, RAG retrieval and MCP tools still work; only final LLM synthesis is unavailable.
ANTHROPIC_API_KEY=

# Claude model used by the orchestrator.
ANTHROPIC_MODEL=claude-sonnet-5

# Embedding model used for RAG (sentence-transformers, runs locally, no API key needed).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Local directory the embedding model is extracted/cached to (see app/rag/embeddings.py).
# If this path already contains a valid sentence-transformers model, it is loaded
# directly (fully offline). Otherwise the app tries, in order: (1) extracting the
# bundled `all-minilm-l6-v2-model` pip package's weights here, (2) downloading
# EMBEDDING_MODEL_NAME from the Hugging Face Hub (requires network access).
EMBEDDING_MODEL_PATH=./models/all-MiniLM-L6-v2

# Path to the persistent Chroma vector store.
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=hr_policy_docs

# Default number of chunks retrieved per RAG query.
RETRIEVAL_TOP_K=4

# Path to mock structured HR data (JSON files).
MOCK_DATA_DIR=./mock_data

# Path to the source policy corpus (markdown/html/txt).
CORPUS_DIR=./corpus

# Host/port for the FastAPI web app.
APP_HOST=0.0.0.0
APP_PORT=8000

# Command used to launch the MCP server as a subprocess (stdio transport).
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m mcp_server.server
